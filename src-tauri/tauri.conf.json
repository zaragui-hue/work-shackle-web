{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "精神状态事务所",
  "version": "0.1.2",
  "identifier": "com.workshackle.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "精神状态事务所",
        "width": 1280,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRFRjgxREVGRjdCNDI3MTQKUldRVUo3VDM3eDM0VHM5bHp6SnlDNXUxNVZhSkNDNlA1RHNxeGIyT081K0o1b1JWVmJ5QXhVRlAK",
      "endpoints": [
        "https://github.com/zaragui-hue/work-shackle-web/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
